# ==========================================
# ОСНОВНЫЕ ПЕРЕМЕННЫЕ
# ==========================================
include ~/.config/sway/themes/gruvbox

set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term foot
set $menu "rofi -combi-modi window,drun,ssh,run -show combi -show-icons"

set $wallpaper ~/Pictures/Wallpapers/girl-reading-book.png
set $swaylock swaylock -i $wallpaper -k -f


# ==========================================
# МОНИТОРЫ (OUTPUTS) И ОБОИ
# ==========================================
output * bg $wallpaper fill

# Основной монитор (По центру)
output DP-3 resolution 2560x1440 position 0,0
workspace 1 output DP-3

# Второй монитор (Справа, повернут вертикально)
output HDMI-A-1 resolution 1920x1080 position 2560,0 transform 270


# ==========================================
# УСТРОЙСТВА ВВОДА (INPUTS)
# ==========================================
input * {
    xkb_layout us,ru
    xkb_options grp:alt_shift_toggle
}


# ==========================================
# АВТОЗАПУСК (AUTOSTART)
# ==========================================
# Системные службы
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec gnome-keyring-daemon --start --components=secrets
exec_always ~/.config/sway/run_autotiling

# Пользовательские приложения
exec mako
exec nm-applet --no-agent

# Управление питанием и блокировка экрана
exec swayidle -w \
    timeout 300 '$swaylock' \
    timeout 600 'swaymsg "output * dpms off"' \
         resume 'swaymsg "output * dpms on"' \
   before-sleep '$swaylock'

# ==========================================
# ГОРЯЧИЕ КЛАВИШИ: БАЗОВЫЕ
# ==========================================
bindsym --to-code $mod+Return exec $term
bindsym --to-code $mod+d exec $menu
bindsym --to-code $mod+e exec foot --app-id yazi-fm yazi
bindsym --to-code $mod+q kill
bindsym --to-code $mod+Shift+c reload
bindsym --to-code $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

# ==========================================
# ГОРЯЧИЕ КЛАВИШИ: МЕДИА И СКРИНШОТЫ
# ==========================================
# Звук (PipeWire / wpctl)
bindsym --to-code XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --to-code XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --to-code XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-

# Скриншоты
## Скриншот только активного монитора
bindsym --to-code Print exec sh -c 'grim -o "$(swaymsg -t get_outputs | jq -r ".[] | select(.focused) | .name")" - | tee $HOME/Pictures/screen-$(date +%s).png | wl-copy -t image/png && notify-send "Скриншот" "Текущий монитор сохранен и скопирован"'
## Скриншот выделенной области
bindsym --to-code $mod+Print exec grim -g "$(slurp)" - | tee $HOME/Pictures/screen-$(date +%s).png | wl-copy -t image/png && notify-send "Скриншот области" "Сохранен в Pictures и скопирован"

# ==========================================
# ГОРЯЧИЕ КЛАВИШИ: УПРАВЛЕНИЕ ОКНАМИ
# ==========================================
floating_modifier $mod normal

# Фокус (Vim-style и Стрелки)
bindsym --to-code $mod+$left focus left
bindsym --to-code $mod+$down focus down
bindsym --to-code $mod+$up focus up
bindsym --to-code $mod+$right focus right
bindsym --to-code $mod+Left focus left
bindsym --to-code $mod+Down focus down
bindsym --to-code $mod+Up focus up
bindsym --to-code $mod+Right focus right

# Перемещение окон (Vim-style и Стрелки)
bindsym --to-code $mod+Shift+$left move left
bindsym --to-code $mod+Shift+$down move down
bindsym --to-code $mod+Shift+$up move up
bindsym --to-code $mod+Shift+$right move right
bindsym --to-code $mod+Shift+Left move left
bindsym --to-code $mod+Shift+Down move down
bindsym --to-code $mod+Shift+Up move up
bindsym --to-code $mod+Shift+Right move right

# Управление Layout
bindsym --to-code $mod+b splith
bindsym --to-code $mod+v splitv
bindsym --to-code $mod+s layout stacking
bindsym --to-code $mod+w layout tabbed
bindsym --to-code $mod+t layout toggle split  # Изменено с $mod+e на $mod+t
bindsym --to-code $mod+f fullscreen
bindsym --to-code $mod+Shift+space floating toggle
bindsym --to-code $mod+space focus mode_toggle
bindsym --to-code $mod+a focus parent

# Scratchpad (Скрытые окна)
bindsym --to-code $mod+Shift+minus move scratchpad
bindsym --to-code $mod+minus scratchpad show

# Перемещение рабочих столов между мониторами
bindsym $mod+Ctrl+Right move workspace to output HDMI-A-1
bindsym $mod+Ctrl+Left move workspace to output DP-3


# ==========================================
# ГОРЯЧИЕ КЛАВИШИ: РАБОЧИЕ СТОЛЫ
# ==========================================
bindsym --to-code $mod+1 workspace number 1
bindsym --to-code $mod+2 workspace number 2
bindsym --to-code $mod+3 workspace number 3
bindsym --to-code $mod+4 workspace number 4
bindsym --to-code $mod+5 workspace number 5
bindsym --to-code $mod+6 workspace number 6
bindsym --to-code $mod+7 workspace number 7
bindsym --to-code $mod+8 workspace number 8
bindsym --to-code $mod+9 workspace number 9
bindsym --to-code $mod+0 workspace number 10

bindsym --to-code $mod+Shift+1 move container to workspace number 1
bindsym --to-code $mod+Shift+2 move container to workspace number 2
bindsym --to-code $mod+Shift+3 move container to workspace number 3
bindsym --to-code $mod+Shift+4 move container to workspace number 4
bindsym --to-code $mod+Shift+5 move container to workspace number 5
bindsym --to-code $mod+Shift+6 move container to workspace number 6
bindsym --to-code $mod+Shift+7 move container to workspace number 7
bindsym --to-code $mod+Shift+8 move container to workspace number 8
bindsym --to-code $mod+Shift+9 move container to workspace number 9
bindsym --to-code $mod+Shift+0 move container to workspace number 10


# ==========================================
# РЕЖИМ ИЗМЕНЕНИЯ РАЗМЕРА ОКОН (RESIZE)
# ==========================================
mode "resize" {
    bindsym --to-code $left resize shrink width 10px
    bindsym --to-code $down resize grow height 10px
    bindsym --to-code $up resize shrink height 10px
    bindsym --to-code $right resize grow width 10px

    bindsym --to-code Left resize shrink width 10px
    bindsym --to-code Down resize grow height 10px
    bindsym --to-code Up resize shrink height 10px
    bindsym --to-code Right resize grow width 10px

    bindsym --to-code Return mode "default"
    bindsym --to-code Escape mode "default"
}
bindsym --to-code $mod+r mode "resize"


# ==========================================
# ПАНЕЛЬ СОСТОЯНИЯ (WAYBAR)
# ==========================================
bar {
    swaybar_command waybar
}


# ==========================================
# ПРАВИЛА ОКОН (WINDOW RULES)
# ==========================================
# Плавающие окна по умолчанию
for_window [app_id="Launcher"] floating enable, border pixel 10, sticky enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="dialog"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_type="menu"] floating enable
for_window [app_id="floating"] floating enable
for_window [app_id="floating_update"] floating enable, resize set width 1000px height 600px
for_window [class="(?i)pinentry"] floating enable
for_window [title="Administrator privileges required"] floating enable
for_window [app_id="yazi-fm"] floating enable, resize set width 1000px height 700px

# Firefox
for_window [title="About Mozilla Firefox"] floating enable
for_window [window_role="About"] floating enable
for_window [app_id="firefox" title="Library"] floating enable, border pixel 1, sticky enable

# Системные инклуды (оставляем в самом конце)
include /etc/sway/config.d/*